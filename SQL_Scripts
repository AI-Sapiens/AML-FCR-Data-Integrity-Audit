-- Create a high-signal extract for Power BI
SELECT TOP 100000 *
INTO PowerBI_AML_Reporting
FROM Curated_AML_Analytics
WHERE Integrity_Risk_Tier IN ('CRITICAL: Structuring Indicator', 'HIGH: Velocity Anomaly', 'MEDIUM: Mandatory CTR Threshold')
   OR Is_Laundering = 1

UNION ALL

SELECT TOP 50000 *
FROM Curated_AML_Analytics
WHERE Integrity_Risk_Tier = 'LOW: Standard Activity'
  AND Is_Laundering = 0;
