-- Create the curated analytics table
SELECT 
    From_Account AS Account_ID,
    From_Bank AS Source_Bank,
    To_Bank AS Destination_Bank,
    Payment_Format,
    CAST([Timestamp] AS DATE) AS Tx_Date,
    [Timestamp] AS Tx_Timestamp,
    Amount_Paid,
    Payment_Currency,
    Is_Laundering,
    
    -- Feature 1: Structuring Indicator Flag
    CASE 
        WHEN Amount_Paid BETWEEN 8500.00 AND 9999.99 THEN 1 
        ELSE 0 
    END AS Structuring_Flag,
    
    -- Feature 2: Transaction Velocity (Rolling 24h count per account)
    COUNT(*) OVER(
        PARTITION BY From_Account, CAST([Timestamp] AS DATE)
    ) AS Daily_Tx_Velocity,
    
    -- Feature 3: Rolling Daily Volume
    SUM(Amount_Paid) OVER(
        PARTITION BY From_Account, CAST([Timestamp] AS DATE)
    ) AS Daily_Total_Volume

INTO Curated_AML_Analytics
FROM Stage_Transactions;
GO

-- Add Primary Risk Tiering logic
ALTER TABLE Curated_AML_Analytics ADD Integrity_Risk_Tier VARCHAR(50);
GO

UPDATE Curated_AML_Analytics
SET Integrity_Risk_Tier = CASE 
    WHEN Structuring_Flag = 1 AND Daily_Tx_Velocity >= 2 THEN 'CRITICAL: Structuring Indicator'
    WHEN Daily_Tx_Velocity >= 8 THEN 'HIGH: Velocity Anomaly'
    WHEN Amount_Paid >= 10000 THEN 'MEDIUM: Mandatory CTR Threshold'
    ELSE 'LOW: Standard Activity'
END;
GO
